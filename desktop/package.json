{
  "name": "ta-super-agent-desktop",
  "productName": "助教工作台",
  "version": "0.7.0",
  "description": "通过SSH连接助教服务器的课程工作台",
  "author": "TA Super Agent",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "npmRebuild": false,
    "appId": "local.ta.superagent.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "artifactName": "TA-Workbench-${version}-${arch}.${ext}"
  }
}
