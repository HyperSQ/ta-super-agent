[Unit]
Description=Teaching assistant dedicated QQ client and PMHQ
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=ta-qqbot
Group=ta-qqbot
Slice=ta-assistant.slice
WorkingDirectory=/var/lib/ta-llbot
Environment=HOME=/var/lib/ta-llbot/qq-home
Environment=XDG_CONFIG_HOME=/var/lib/ta-llbot/qq-home/.config
Environment=XDG_RUNTIME_DIR=/var/lib/ta-llbot/run
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x900x24 -nolisten tcp" /opt/ta-llbot/bin/pmhq/pmhq --config /opt/ta-llbot/bin/pmhq/pmhq_config.json
Restart=always
RestartSec=30
TimeoutStopSec=30
MemoryMax=768M
CPUQuota=70%
Nice=10
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ta-llbot

[Install]
WantedBy=multi-user.target
