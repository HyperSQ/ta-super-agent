HOST=127.0.0.1
PORT=8787
DATABASE_PATH=var/db/ta.sqlite
# 两个不同的随机令牌，启动时必须配置；勿提交真实凭据。
ADMIN_TOKEN=
QQ_WEBHOOK_TOKEN=
# 教师QQ用真实ID；课程与群号通过管理API创建。
TEACHER_QQ_IDS=
WORKER_CONCURRENCY=3
# 开启后，疑似串台反馈先由限权分类器复核再进入答疑。需要已配置模型。
THREAD_RECLASSIFY_ENABLED=false
# 无模型时仍可测试管理API和持久任务，答疑任务进入blocked状态。
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
MODEL_TIMEOUT_MS=60000
# 官方 DeepSeek Flash 自动启用原页/作业题图；兼容视觉接口可显式设为 true。
# MODEL_VISION_ENABLED=true
# PDF_RENDERER=pdftoppm
# 教材包放入独立资料目录；课程通过textbookIds绑定教材ID。
LIBRARY_PATH=var/library
# 可选OpenAI兼容 /embeddings 完整端点；留空时如实使用BM25与精确关联。
# 指纹必须对应模型权重、维数、pooling、模板、EOS等完整配置。
# 导入旧教材向量时，必须与manifest.embedding.configHash一致。
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_CONFIG_HASH=
EMBEDDING_DIMENSIONS=1024
# 查询前缀中的字面量\n会转换为换行；须与教材manifest一致。
EMBEDDING_QUERY_PREFIX=
# 需显式开启外发。默认仅生成待交付结果，适合首次本地验证。
QQ_SEND_ENABLED=false
LLBOT_HTTP_URL=http://127.0.0.1:13010
LLBOT_ACCESS_TOKEN=
# 仅在独立LLBot部署后填写实例ID；留空时桌面端拒绝连接任何旧实例。
LLBOT_INSTANCE_ID=
LLBOT_WEBUI_PORT=13080
LLBOT_PMHQ_PORT=13200
LLBOT_DATA_DIR=/var/lib/ta-llbot/data
LLBOT_SETUP_STATE=awaiting-auth

# 同线程待处理消息的合并窗口（毫秒）。0 或留空表示立即路由；1500–3000 可减少同一讨论的重复运行。
# TA_BATCH_MS=0

# 部署与验收用的真实标识只写在 .env（已被 .gitignore 排除），文档与代码不保存真实值。
# TA_SERVER_HOST=203.0.113.10
# TA_SERVER_SSH_PORT=22
# TA_SERVER_DIR=/opt/ta-super-agent
# TA_SERVER_KERNEL_PORT=18787
# ASSISTANT_QQ=
# TA_TEST_GROUP_ID=
# TA_TEST_COURSE_ID=

# 可选的 Linux DSH 定时 Worker。设置为部署的沙箱启动脚本绝对路径。
TA_DSH_LAUNCHER=
TA_DSH_WORKSPACE=var/dsh
TA_DSH_TIMEOUT_MS=240000
